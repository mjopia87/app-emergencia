  "validaciones": {
    "ppu": {
      "requerido": true,
      "unico": true,
      "minLength": 5,
      "maxLength": 10,
      "patron": "^[A-Z0-9-]+$"
    },
    "tipoVehiculo": {
      "requerido": true,
      "tipo": "enumerado"
    },
    "combustible": {
      "requerido": true,
      "tipo": "enumerado"
    },
    "marca": {
      "requerido": true,
      "tipo": "lista o texto"
    },
    "modelo": {
      "requerido": true,
      "minLength": 1,
      "maxLength": 100
    },
    "anio": {
      "requerido": true,
      "tipo": "numero",
      "minimo": 1990,
      "maximo": 2026
    }
  }
}
